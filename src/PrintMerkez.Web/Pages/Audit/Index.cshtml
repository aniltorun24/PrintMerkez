@page
@model PrintMerkez.Web.Pages.Audit.IndexModel
@{ ViewData["Title"] = "Denetim kayıtları"; }
<div class="page-heading"><div><div class="eyebrow">YÖNETİM İŞLEMLERİ</div><h1>Denetim kayıtları</h1><p>Envanter, kullanıcı, departman ve tarife değişikliklerinin önceki ve sonraki değerleri.</p></div></div><p class="explanation">AD etkin olmadığı için yerel işlemlerin gerçek kişisi doğrulanamaz; kayıtlar bu durumla etiketlenir. Uygulama üzerinden değiştirme ve silme yoktur. Veritabanı yöneticisine karşı değişmezlik garantisi verilmez.</p><form method="get" class="filters"><label>İşlemi yapan, kayıt türü veya kimliği<input asp-for="Search" maxlength="120" /></label><button class="button secondary">Ara</button></form><section class="panel"><div class="panel-heading"><h2>@Model.Total kayıt</h2></div><div class="table-scroll"><table><thead><tr><th>Zaman / işlemi yapan</th><th>Kayıt</th><th>İşlem</th><th>Değişiklik</th></tr></thead><tbody>
@if(Model.Entries.Count == 0){<tr><td colspan="4" class="empty">Henüz yönetim işlemi kaydedilmedi.</td></tr>}
@foreach(var entry in Model.Entries){<tr><td>@PrintMerkez.Web.Pages.Audit.IndexModel.Local(entry.OccurredAtUtc).ToString("dd.MM.yyyy HH:mm:ss")<small>@entry.Actor</small></td><td>@PrintMerkez.Web.Pages.Audit.IndexModel.EntityLabel(entry.Entity)<small>#@entry.EntityKey</small></td><td>@PrintMerkez.Web.Pages.Audit.IndexModel.ActionLabel(entry.Action)</td><td><details><summary>Önce / sonra</summary><div class="audit-detail"><table><thead><tr><th>Alan</th><th>Önce</th><th>Sonra</th></tr></thead><tbody>@foreach(var change in PrintMerkez.Web.Pages.Audit.IndexModel.Changes(entry)){<tr><td>@change.Field</td><td>@change.Before</td><td>@change.After</td></tr>}</tbody></table></div></details></td></tr>}
</tbody></table></div><div class="pagination">@if(Model.PageNumber>1){<a asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber-1)">← Önceki</a>}else{<span>Başlangıç</span>}<span>@Model.PageNumber / @Model.TotalPages</span>@if(Model.PageNumber<Model.TotalPages){<a asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber+1)">Sonraki →</a>}else{<span>Son sayfa</span>}</div></section>
