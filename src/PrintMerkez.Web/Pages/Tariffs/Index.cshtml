@page
@model PrintMerkez.Web.Pages.Tariffs.IndexModel
@{ ViewData["Title"] = "Maliyet tarifeleri"; }
<div class="page-heading"><div><div class="eyebrow">MALİYET YÖNETİMİ</div><h1>Maliyet tarifeleri</h1><p>Yazıcı bazında geçerlilik tarihli birim maliyetler tanımlayın.</p></div></div><p class="explanation">100 kuruş = 1 TL. Fiyatlar kopyalar dahil toplam baskı yüzüne uygulanır. Eski tarife düzenlenmez; yeni sürüm eklenir. Yeni gelen olayın zamanına uygun tarife seçilir; kayıtlı tutarlar geriye dönük değişmez.</p>
<div class="management-grid"><section class="panel"><div class="panel-heading"><h2>Tarife geçmişi</h2><span class="help">Son 200 sürüm · Türkiye saati</span></div><div class="table-scroll"><table><thead><tr><th>Yazıcı</th><th>Geçerlilik başlangıcı</th><th>S/B (TL)</th><th>Renkli (TL)</th></tr></thead><tbody>
@if(Model.Tariffs.Count == 0){<tr><td colspan="4" class="empty">Henüz tarife yok. Uydurma fiyat kullanılmaz.</td></tr>}
@foreach(var t in Model.Tariffs){<tr><td>@t.Printer.Name</td><td>@PrintMerkez.Web.Pages.Tariffs.IndexModel.Local(t.EffectiveFromUtc).ToString("dd.MM.yyyy HH:mm")</td><td>@((t.MonochromeKurus / 100m).ToString("N2"))</td><td>@((t.ColorKurus / 100m).ToString("N2"))</td></tr>}
</tbody></table></div></section><form method="post" class="panel padded"><h2>Yeni tarife sürümü</h2><div asp-validation-summary="All"></div><div class="field"><label asp-for="Input.PrinterId">Yazıcı</label><select asp-for="Input.PrinterId"><option value="0">Yazıcı seçin</option>@foreach(var p in Model.Printers){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label asp-for="Input.EffectiveFrom">Başlangıç (Türkiye saati)</label><input asp-for="Input.EffectiveFrom" type="datetime-local" /></div><div class="field"><label asp-for="Input.MonochromeKurus">Siyah-beyaz (kuruş / yüz)</label><input asp-for="Input.MonochromeKurus" min="0" max="1000000" type="number" /></div><div class="field"><label asp-for="Input.ColorKurus">Renkli (kuruş / yüz)</label><input asp-for="Input.ColorKurus" min="0" max="1000000" type="number" /></div><button class="button">Tarifeyi kaydet</button></form></div>
