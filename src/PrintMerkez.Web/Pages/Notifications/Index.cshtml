@page
@model PrintMerkez.Web.Pages.Notifications.IndexModel
@{ViewData["Title"]="Baskı uyarıları";}
<div class="page-heading"><div><div class="eyebrow">YÖNETİCİ BİLDİRİMLERİ</div><h1>Baskı uyarıları</h1><p>Eşik aşımlarını, mail önizlemelerini ve gönderim sonuçlarını izleyin.</p></div><a class="button" asp-page="Policies">Aylık uyarı kuralları</a></div>
<p class="explanation"><strong>Gönderim modu: @Model.Mode.</strong> Preview modunda ve bütün simülasyonlarda dışarı mail gönderilmez. SMTP kabulü alıcının okuduğu anlamına gelmez. Teslimi belirsiz kalan mesaj otomatik olarak tekrar gönderilmez. Eksik yönetici/e-posta eşleştirmesi düzenlendiğinde kuyruk tekrar kontrol edilir.</p>
<div class="actions" style="margin-bottom:22px"><form method="post" asp-page-handler="Evaluate"><button class="button secondary">Mevcut ayı değerlendir</button></form><form method="post" asp-page-handler="Process"><button class="button secondary">Kuyruğu kontrol et</button></form><a asp-page="/Managers/Index">Yönetici atamaları →</a></div>
<form method="get" class="filters"><label>Bildirim durumu<select asp-for="State"><option value="">Tümü</option>@foreach(var state in Enum.GetValues<NotificationState>()){<option value="@state">@state.Display()</option>}</select></label><button class="button secondary">Filtrele</button></form>
<section class="panel"><div class="panel-heading"><h2>@Model.Total bildirim</h2><span class="help">Sayfa başına 25 kayıt</span></div><div class="table-scroll"><table><thead><tr><th>Kullanıcı / kural</th><th>Dönem / kaynak</th><th>Toplam / eşik</th><th>Alıcı</th><th>Durum</th><th>Ayrıntı</th></tr></thead><tbody>@if(Model.Notifications.Count==0){<tr><td colspan="6" class="empty">Henüz eşik aşımı bildirimi yok.</td></tr>}@foreach(var n in Model.Notifications){<tr><td><strong>@n.DisplayName</strong><small>@n.Account</small><small>@n.Policy.Name</small></td><td>@n.PeriodLabel<small>@(n.Source==EventSource.Simulation?"Simülasyon":"Windows")</small></td><td>@n.TotalImpressions.ToString("N0") / @n.Threshold.ToString("N0")</td><td>@(n.RecipientEmail??"Eşleşme bekleniyor")</td><td><span class="badge @(n.State is NotificationState.Failed or NotificationState.Uncertain?"error":"neutral")">@n.State.Display()</span><small>Deneme: @n.Attempts</small></td><td><details><summary>Mail ve durum</summary><div class="audit-detail"><strong>@n.Subject</strong><pre>@n.Body</pre><p>@n.LastError</p><small>Oluşturulma: @PrintMerkez.Web.Pages.Notifications.IndexModel.Local(n.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm")</small>@if(n.State==NotificationState.Failed){<form method="post" asp-page-handler="Retry" asp-route-id="@n.Id"><button class="button secondary">Yeniden dene</button></form>}@if(n.State is NotificationState.Pending or NotificationState.Retry or NotificationState.Blocked or NotificationState.Failed or NotificationState.Uncertain){<form method="post" asp-page-handler="Cancel" asp-route-id="@n.Id"><button class="button secondary">Bildirimi iptal et</button></form>}</div></details></td></tr>}</tbody></table></div><div class="pagination">@if(Model.PageNumber>1){<a asp-route-State="@Model.State" asp-route-PageNumber="@(Model.PageNumber-1)">← Önceki</a>}else{<span>Başlangıç</span>}<span>@Model.PageNumber / @Model.TotalPages</span>@if(Model.PageNumber<Model.TotalPages){<a asp-route-State="@Model.State" asp-route-PageNumber="@(Model.PageNumber+1)">Sonraki →</a>}else{<span>Son sayfa</span>}</div></section>
