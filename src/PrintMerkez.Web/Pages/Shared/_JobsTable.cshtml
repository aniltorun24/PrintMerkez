@model IReadOnlyList<PrintMerkez.Core.PrintJob>
<div class="table-scroll"><table><thead><tr><th>Kullanıcı / zaman</th><th>Yazıcı / lokasyon</th><th>Windows belge sayfası</th><th>Kopya sayısı</th><th>Toplam baskı yüzü</th><th>Baskı rengi</th><th>Tutar / kapsam</th><th>Durum</th><th>Kaynak</th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="9" class="empty">Bu koşullara uygun baskı kaydı yok.</td></tr>}
@foreach(var job in Model){<tr><td><strong>@(job.UserDisplayName ?? job.Account)</strong><small>@job.Account · @(job.DepartmentName ?? "Departman eşleşmedi")</small><small>@job.LocalTime().ToString("dd.MM.yyyy HH:mm")</small></td><td>@job.Printer.Name<small>@job.Location.Name</small></td><td>@(job.ReportedDocumentPages?.ToString("N0") ?? "—")</td><td>@(job.Copies?.ToString("N0") ?? "Bilinmiyor")</td><td>@(job.Impressions?.ToString("N0") ?? "Doğrulanmadı")@if(job.DeviceJobKey is not null){<small>Cihaz iş kaydıyla doğrulandı</small>}</td><td>@job.Color.Display()@if(job.RequestedColor != PrintColor.Unknown){<small>Windows kaydı: @job.RequestedColor.Display()</small>}</td><td>@(job.CostKurus.HasValue ? (job.CostKurus.Value / 100m).ToString("N2") + " ₺" : "—")<small>@PrintMerkez.Web.Services.CostCalculator.Label(job.CostState)</small></td><td><span class="badge @(job.Status==PrintJobStatus.Failed ? "error" : "neutral")">@job.Status.Display()</span></td><td><span class="badge @(job.Source==EventSource.Simulation ? "demo" : "neutral")">@(job.Source==EventSource.Simulation ? "Simülasyon" : "Windows")</span></td></tr>}
</tbody></table></div>
