@page "{id:int?}"
@model PrintMerkez.Web.Pages.Users.IndexModel
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="page-heading"><div><div class="eyebrow">KULLANICI DİZİNİ</div><h1>Kullanıcılar</h1><p>Hesap, departman, lokasyon ve bildirim rollerini yönetin.</p></div></div><p class="explanation">Çalışan/Yönetici rolü bildirim yönlendirmesi içindir; oturum açma veya uygulama erişim yetkisi vermez. Pasif işareti baskıyı engellemez. Eşleştirmeler yalnızca yeni gelen olaylara uygulanır; geçmiş kayıtlar korunur.</p>
<div class="management-grid"><section class="panel"><div class="panel-heading"><h2>Kullanıcı listesi</h2><span class="help">En fazla 200 kayıt</span></div><form method="get" asp-route-id="" class="filters padded"><label>Hesap veya ad soyad<input asp-for="Search" /></label><button class="button secondary">Ara</button></form><div class="table-scroll"><table><thead><tr><th>Kullanıcı / hesap</th><th>Departman / lokasyon</th><th>Bildirim rolü</th><th>Durum</th><th></th></tr></thead><tbody>
@if(Model.Users.Count == 0){<tr><td colspan="5" class="empty">Bu koşullara uygun kullanıcı bulunamadı.</td></tr>}
@foreach(var u in Model.Users){<tr><td><strong>@u.DisplayName</strong><small>@u.Account</small></td><td>@(u.Department?.Name ?? "Eşleştirilmedi")<small>@(u.Location?.Name ?? "Lokasyon tanımlanmadı")</small></td><td>@u.Role.Display()<small>@(u.Email ?? "E-posta yok")</small></td><td>@(u.IsActive ? "Aktif" : "Pasif")</td><td><a asp-route-id="@u.Id">Düzenle</a></td></tr>}
</tbody></table></div></section><form method="post" class="panel padded"><h2>@(Model.EditingId.HasValue ? "Kullanıcıyı düzenle" : "Kullanıcı ekle")</h2><div asp-validation-summary="All"></div><div class="field"><label asp-for="Input.Account">Baskı hesabı</label><input asp-for="Input.Account" placeholder="DOMAIN\kullanici" /><p class="help">Baskı olayındaki hesap biçimiyle eşleşmeli. Parola saklanmaz.</p></div><div class="field"><label asp-for="Input.DisplayName">Ad soyad</label><input asp-for="Input.DisplayName" /></div><div class="field"><label asp-for="Input.DepartmentId">Departman</label><select asp-for="Input.DepartmentId"><option value="">Eşleştirilmedi</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name @(d.IsActive ? "" : "(pasif)")</option>}</select></div><div class="field"><label asp-for="Input.LocationId">Lokasyon</label><select asp-for="Input.LocationId"><option value="">Tanımlanmadı</option>@foreach(var l in Model.Locations){<option value="@l.Id">@l.Name</option>}</select></div><div class="field"><label asp-for="Input.Role">Bildirim rolü</label><select asp-for="Input.Role"><option value="Employee">Çalışan</option><option value="Manager">Yönetici</option></select></div><div class="field"><label asp-for="Input.Email">E-posta adresi</label><input asp-for="Input.Email" type="email" /><p class="help">Yönetici rolünde zorunludur. Bildirim alıcısı ayrıca departman/lokasyon atamasında seçilir.</p></div><label class="checkbox"><input asp-for="Input.IsActive" /> Aktif kullanıcı</label><div class="actions"><button class="button">Kaydet</button><a asp-route-id="">Yeni kayıt</a></div></form></div>
