@page "{id:int?}"
@model PrintMerkez.Web.Pages.Users.IndexModel
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="page-heading"><div><div class="eyebrow">KULLANICI DİZİNİ</div><h1>Kullanıcılar</h1><p>Hesap, departman, lokasyon ve bildirim rollerini yönetin.</p></div>@if(User.IsInRole("Admin")){<a class="button" asp-page="/Users/Edit">+ Kullanıcı ekle</a>}</div><p class="explanation">Çalışan/Yönetici rolü bildirim yönlendirmesi içindir; oturum açma veya uygulama erişim yetkisi vermez. Pasif işareti baskıyı engellemez. Eşleştirmeler yalnızca yeni gelen olaylara uygulanır; geçmiş kayıtlar korunur.</p>
<section class="panel"><div class="panel-heading"><h2>Kullanıcı listesi</h2><span class="help">@Model.Total.ToString("N0") kullanıcı · Sayfa başına 50</span></div><form method="get" asp-route-id="" class="filters padded"><label>Hesap veya ad soyad<input asp-for="Search" /></label><button class="button secondary">Ara</button></form><div class="table-scroll"><table><thead><tr><th>Kullanıcı / hesap</th><th>Departman / lokasyon</th><th>Bildirim rolü</th><th>Durum</th><th></th></tr></thead><tbody>
@if(Model.Users.Count == 0){<tr><td colspan="5" class="empty">Bu koşullara uygun kullanıcı bulunamadı.</td></tr>}
@foreach(var u in Model.Users){<tr><td><a asp-page="/Users/Details" asp-route-id="@u.Id"><strong>@u.DisplayName</strong></a><small>@u.Account</small>@if(u.AdObjectGuid is not null){<small>AD kaydı</small>}</td><td>@(u.Department?.Name ?? "Eşleştirilmedi")<small>@(u.Location?.Name ?? "Lokasyon tanımlanmadı")</small></td><td>@u.Role.Display()<small>@(u.Email ?? "E-posta yok")</small></td><td>@(u.IsActive ? "Aktif" : "Pasif")</td><td>@if(User.IsInRole("Admin")){<a asp-page="/Users/Edit" asp-route-id="@u.Id" asp-route-Search="@Model.Search" asp-route-ListPage="@Model.PageNumber">Düzenle</a>}</td></tr>}
</tbody></table></div><div class="pagination">
@if(Model.PageNumber>1){<a asp-page="/Users/Index" asp-route-id="" asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-Search="@Model.Search">← Önceki</a>}else{<span>Başlangıç</span>}
<span>@Model.PageNumber / @Model.TotalPages</span>
@if(Model.PageNumber<Model.TotalPages){<a asp-page="/Users/Index" asp-route-id="" asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-Search="@Model.Search">Sonraki →</a>}else{<span>Son sayfa</span>}
</div></section>
