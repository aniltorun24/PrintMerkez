@page "{id:int?}"
@model PrintMerkez.Web.Pages.Managers.IndexModel
@{ViewData["Title"]="Yönetici atamaları";}
<div class="page-heading"><div><div class="eyebrow">BİLDİRİM YÖNLENDİRMESİ</div><h1>Yönetici atamaları</h1><p>Her departman ve lokasyon birleşimi için bildirimi alacak yöneticiyi belirleyin.</p></div></div><p class="explanation">Kullanıcının bağlı olduğu lokasyon esas alınır; baskıyı yaptığı yazıcının lokasyonundan yönetici tahmin edilmez. Kullanıcılar ekranında yöneticinin rolünü, e-postasını ve organizasyonunu önce tanımlayın.</p>
<div class="management-grid"><section class="panel"><div class="panel-heading"><h2>Atamalar</h2><span class="help">En fazla 500 kayıt</span></div><div class="table-scroll"><table><thead><tr><th>Departman / lokasyon</th><th>Yönetici / e-posta</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Assignments.Count==0){<tr><td colspan="4" class="empty">Henüz yönetici ataması yok.</td></tr>}@foreach(var a in Model.Assignments){<tr><td>@a.Department.Name<small>@a.Location.Name</small></td><td>@a.ManagerUser.DisplayName<small>@(a.ManagerUser.Email??"E-posta eksik")</small></td><td>@(a.IsActive?"Aktif":"Kapalı")</td><td><a asp-route-id="@a.Id">Düzenle</a></td></tr>}</tbody></table></div></section><form method="post" class="panel padded"><h2>@(Model.EditingId.HasValue?"Atamayı düzenle":"Yönetici ata")</h2><div asp-validation-summary="All"></div><div class="field"><label asp-for="Input.DepartmentId">Departman</label><select asp-for="Input.DepartmentId"><option value="0">Seçin</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></div><div class="field"><label asp-for="Input.LocationId">Lokasyon</label><select asp-for="Input.LocationId"><option value="0">Seçin</option>@foreach(var l in Model.Locations){<option value="@l.Id">@l.Name</option>}</select></div><div class="field"><label asp-for="Input.ManagerUserId">Bildirimi alacak yönetici</label><select asp-for="Input.ManagerUserId"><option value="0">Seçin</option>@foreach(var u in Model.Managers){<option value="@u.Id">@u.DisplayName (@u.Account)</option>}</select></div><label class="checkbox"><input asp-for="Input.IsActive"/> Aktif atama</label><div class="actions"><button class="button">Kaydet</button><a asp-route-id="">Yeni atama</a></div></form></div>
